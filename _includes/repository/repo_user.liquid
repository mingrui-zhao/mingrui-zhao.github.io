<div class="repo repo-profile p-2">
  <a class="repo-card" href="https://github.com/{{ include.username }}">
    <i class="fa-brands fa-github repo-card-icon" aria-hidden="true"></i>
    <span>
      <strong>{{ include.username }}</strong>
      <small>View GitHub profile</small>
    </span>
    <i class="fa-solid fa-arrow-up-right-from-square repo-card-link" aria-hidden="true"></i>
  </a>
</div>
